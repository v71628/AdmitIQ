# AdmitIQ server configuration. Copy to .env and fill in what you want to enable.
# EVERYTHING HERE IS OPTIONAL — without any of it, AdmitIQ runs fully in local mode
# (all non-AI features, rule-based strategist, heuristic essay analysis, offline research).
# Keys are read only by the server (server/*.mjs) and the ingestion scripts. They are never sent to the browser.
# Full reference: ENVIRONMENT_VARIABLES.md

PORT=8787
APP_URL=http://localhost:8787
# Set to true when running behind a reverse proxy (Render, Fly, Vercel, Nginx) so rate limiting sees real client IPs.
TRUST_PROXY=false
# Requests per minute per IP for AI and research routes (research costs 3).
RATE_LIMIT_PER_MIN=20
# Contact shown in the User-Agent of research/ingestion requests (be a good citizen).
ADMITIQ_CONTACT=

# ---------- AI: OpenAI (primary) ----------
OPENAI_API_KEY=
# Model IDs. Leave blank to auto-pick the newest available model for each tier from /v1/models.
OPENAI_MODEL=
OPENAI_MODEL_FAST=
OPENAI_MODEL_REASONING=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- AI: Google Gemini (research, Google Search grounding) ----------
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MODEL_FAST=
GEMINI_RESEARCH_MODEL=

# ---------- AI: Anthropic Claude (optional: long documents, essay critiques, verification) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MODEL_FAST=
ANTHROPIC_MODEL_REASONING=

# ---------- AI: legacy single provider (still supported) ----------
# One of: none | ollama | groq | gemini | openrouter | openai | anthropic | openai-compatible
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# ---------- AI routing, limits and cost controls ----------
# Override a route: comma-separated provider:tier list, first healthy wins. Tasks: chat, analysis, essay, simulation, research, long_document, verify
# AI_ROUTE_ESSAY=anthropic:main,openai:main
# USD per 1M tokens, used for cost monitoring. Copy current prices from each provider's pricing page.
# AI_PRICING_JSON={"gpt-model-id":{"input":0,"output":0}}
AI_MONTHLY_BUDGET_USD=
# Daily usage units per plan (chat=1, analysis=2, essay=3, research=3, long_document=4, simulation=6)
# AI_DAILY_UNITS_JSON={"anonymous":10,"free":30,"plus":150,"pro":500,"ultimate":1500}
# Plan used when Supabase is not configured (single-user local install)
AI_LOCAL_PLAN=ultimate
AI_TIMEOUT_MS=90000
AI_MAX_RETRIES=2

# ---------- College Scorecard (optional, free) ----------
# Free key: https://api.data.gov/signup
SCORECARD_API_KEY=

# ---------- Web search for the Research center (optional) ----------
# tavily | brave
SEARCH_PROVIDER=
SEARCH_API_KEY=

# ---------- Supabase (accounts, sync, source library, usage) ----------
SUPABASE_URL=
# The anon key is designed to be public; row-level security protects data.
SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses row-level security. Never put this in frontend code or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# When true, AI and research endpoints require a signed-in user.
REQUIRE_AUTH=false
# Comma-separated emails allowed into the admin dashboard.
ADMIN_EMAILS=

# ---------- Stripe (subscriptions) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ULTIMATE_MONTHLY=
STRIPE_PRICE_ULTIMATE_ANNUAL=

# ---------- Data ingestion ----------
# IPEDS years to try, newest first
IPEDS_YEARS=2024,2023,2022
# URBAN_BASE=https://educationdata.urban.org/api/v1
# DIRECTORY_YEARS=2024,2023,2022
